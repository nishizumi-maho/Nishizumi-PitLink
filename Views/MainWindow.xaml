<Window x:Class="NishizumiPitLink.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NishizumiPitLink.Views"
        xmlns:models="clr-namespace:NishizumiPitLink.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Nishizumi PitLink — iRacing car → MOZA Pit House preset switcher"
        Icon="/Assets/icon.ico"
        Height="720" Width="1040" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <views:BoolToConnectedTextConverter x:Key="ConnectedText"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ObjectDataProvider x:Key="MatchKindValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:MatchKind"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <DockPanel>
        <!-- Top status bar -->
        <Border DockPanel.Dock="Top" Background="#1f2937" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel>
                    <TextBlock Text="Nishizumi PitLink" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,20,4"/>
                    <TextBlock Text="iRacing:" Foreground="#9ca3af" Margin="0,0,4,4"/>
                    <TextBlock Text="{Binding IRacingConnected, Converter={StaticResource ConnectedText}}" Foreground="White" Margin="0,0,20,4" FontWeight="SemiBold"/>
                    <TextBlock Text="Current car:" Foreground="#9ca3af" Margin="0,0,4,4"/>
                    <TextBlock Text="{Binding CurrentCarDisplay}" Foreground="White" Margin="0,0,20,4" FontWeight="SemiBold"/>
                    <TextBlock Text="Track:" Foreground="#9ca3af" Margin="0,0,4,4"/>
                    <TextBlock Text="{Binding CurrentTrackDisplay}" Foreground="White" Margin="0,0,20,4" FontWeight="SemiBold"/>
                    <TextBlock Text="Preset applied:" Foreground="#9ca3af" Margin="0,0,4,4"/>
                    <TextBlock Text="{Binding CurrentProfileDisplay}" Foreground="#4ade80" FontWeight="SemiBold" Margin="0,0,0,4"/>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox Content="Automatic switching active" IsChecked="{Binding GlobalEnabled}" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Margin="8">
            <!-- STATUS -->
            <TabItem Header="Status">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Wheelbase:" Margin="0,0,6,0" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding WheelbaseStatus}" Margin="0,0,20,0"/>
                        <Button Content="Refresh status" Command="{Binding RefreshWheelbaseStatusCommand}" Margin="0,0,10,0"/>
                        <Button Content="Reapply preset for current car" Command="{Binding ForceReapplyCommand}"/>
                    </StackPanel>

                    <GroupBox Grid.Row="1" Header="History">
                        <ListBox ItemsSource="{Binding StatusLog}" FontFamily="Consolas" FontSize="12"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- CARS -->
            <TabItem Header="Cars">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.2*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Mapping: car or class → Pit House preset" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="Add manual mapping" Command="{Binding AddMappingCommand}" Margin="0,0,8,0"/>
                            <Button Content="Map current car for this track only" Command="{Binding MapCurrentCarForTrackCommand}"
                                    Visibility="{Binding PerTrackProfilesEnabled, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Mappings}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Kind}" ItemsSource="{Binding Source={StaticResource MatchKindValues}}" Width="90"/>
                                <DataGridTextColumn Header="Car (CarPath) / Class" Binding="{Binding Key}" Width="180"/>
                                <DataGridTextColumn Header="Name (display)" Binding="{Binding DisplayName}" Width="190"/>
                                <DataGridTextColumn Header="Track (if car+track)" Binding="{Binding TrackDisplayName}" Width="150" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Pit House preset" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding TargetDisplayName}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                                <Button Content="Choose..."
                                                        Command="{Binding ElementName=RootWindow, Path=DataContext.ChooseMappingTargetCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding Enabled}" Width="50"/>
                                <DataGridTemplateColumn Header="" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove"
                                                    Command="{Binding ElementName=RootWindow, Path=DataContext.DeleteMappingCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Margin="0,10,0,6" FontWeight="SemiBold"
                               Text="Cars seen in iRacing without an assigned preset"/>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding DiscoveredCars}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Car" Binding="{Binding CarScreenName}" Width="200" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Class" Binding="{Binding CarClassShortName}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Track" Binding="{Binding TrackDisplayName}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenUtc}" Width="150" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Assign preset" Margin="0,0,6,0"
                                                    Command="{Binding ElementName=RootWindow, Path=DataContext.AssignDiscoveredCarCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Assign for this track only" Margin="0,0,6,0"
                                                    Visibility="{Binding ElementName=RootWindow, Path=DataContext.PerTrackProfilesEnabled, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding ElementName=RootWindow, Path=DataContext.AssignDiscoveredCarForTrackCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Dismiss"
                                                    Command="{Binding ElementName=RootWindow, Path=DataContext.DismissDiscoveredCarCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- SETTINGS -->
            <TabItem Header="Settings">
                <StackPanel Margin="16">
                    <CheckBox Content="Start with Windows (minimized to tray)" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,14"/>

                    <CheckBox Content="Enable per-track profiles (car + track combination)" IsChecked="{Binding PerTrackProfilesEnabled}" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" MaxWidth="640" HorizontalAlignment="Left" FontSize="11" Margin="0,0,0,14"
                               Text="Off by default. When on, you can map a preset to one specific car on one specific track (Cars tab) - that mapping wins over a plain car or class mapping whenever you're on that exact track."/>

                    <Button Content="Open Pit House presets folder" Command="{Binding OpenPresetsFolderCommand}" HorizontalAlignment="Left" Margin="0,0,0,14"/>

                    <TextBlock TextWrapping="Wrap" Foreground="Gray" MaxWidth="640" HorizontalAlignment="Left"
                               Text="This app never edits force feedback itself - all FFB tuning happens in MOZA Pit House, as usual. Here you only decide which already-saved Pit House Motor preset should load for which car (or car+track). When iRacing reports a matching car, this app reads that preset fresh from disk and pushes it to the wheelbase through the official MOZA SDK, in parallel with Pit House (which must stay open - it owns the wheelbase connection). Car and track detection reads iRacing's shared-memory telemetry directly. Mappings are saved in %AppData%\NishizumiPitLink\state.json."/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
